@model List<StudentPortal.Models.Student>

<h1>Student List</h1>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Marks</th>
            <th>Result</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.Marks</td>
                <td>
                    @if (student.Marks >= 40)
                    {
                        <span>Pass</span>
                    }
                    else
                    {
                        <span>Fail</span>
                    }
                </td>
                <td>
                    <a asp-controller="Student" asp-action="Details" asp-route-id="@student.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>